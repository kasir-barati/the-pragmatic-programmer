{
  "toolbar": {
    "code_actions": false,
  },
  "languages": {
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
      "format_on_save": "on",
    },
    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
      "format_on_save": "on",
    },
  },
  "git_panel": {
    "file_icons": false,
    "tree_view": false,
    "starts_open": false,
  },
  "project_panel": {
    "git_status_indicator": true,
  },
  "tabs": {
    "git_status": true,
  },
  "title_bar": {
    "show_branch_status_icon": true,
  },
  "format_on_save": "on",
  "terminal": {
    "max_scroll_history_lines": 100000,
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "base_keymap": "VSCode",
  "icon_theme": "Zed (Default)",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
}
